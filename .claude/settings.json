{
  "permissions": {
    "allow": [
      "Bash(.venv/Scripts/python.exe -m pytest*)",
      "Bash(.venv/Scripts/ruff.exe *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ],
    "deny": [
      "Read(./.env)",
      "Edit(./.env)",
      "Read(**/.env)",
      "Edit(**/.env)",
      "Read(**/.env.local)",
      "Edit(**/.env.local)",
      "Read(**/.env.*.local)",
      "Edit(**/.env.*.local)",
      "Read(**/.env.prod*)",
      "Edit(**/.env.prod*)",
      "Read(**/.env.dev*)",
      "Edit(**/.env.dev*)",
      "Read(**/.env.test*)",
      "Edit(**/.env.test*)",
      "Bash(cat *.env*)",
      "Bash(type *.env*)",
      "Bash(Get-Content *.env*)",
      "PowerShell(Get-Content *.env*)",
      "PowerShell(cat *.env*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Edit|Write|NotebookEdit|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/post_edit.py\"",
            "timeout": 30,
            "statusMessage": "ruff format + fix"
          }
        ]
      }
    ]
  }
}
